# Container image for hosting the FinSentry-Mini dashboard on Vercel (built from GitHub on every push).
# It serves the saved results in outputs/ and the saved model in models/; it never trains
# and does not include the PaySim dataset.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Exact versions the saved models were trained with; a different scikit-learn version
# may fail to load models/*.joblib.
COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY .streamlit ./.streamlit
COPY Results.py finsentry.py ./
COPY pages ./pages
COPY outputs ./outputs
COPY models ./models

# Vercel routes traffic to $PORT (default 80). Streamlit serves its health check at /_stcore/health.
CMD ["sh", "-c", "exec streamlit run Results.py --server.port ${PORT:-80} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
